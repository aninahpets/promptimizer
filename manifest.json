{
  "manifest_version": 3,
  "name": "Promptimizer",
  "version": "1.0.0",
  "description": "Turn a rough idea into a precisely engineered AI prompt — generated privately, on-device.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Promptimizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
